# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
# build/ output is generated — except the attr-codegen manifest, which is
# committed so library repos can verify their vendored tables against it
# (an ignored parent DIRECTORY would block the re-include, hence /build/*).
/build/*
!/build/attr_codegen
/build/attr_codegen/*
!/build/attr_codegen/manifest.json
dist/
.pytest_cache/

# Ruby / RSpec
coverage/
.rspec_status

# OS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Local-only docs — bug reports / plans / design notes often quote
# consumer-app names and local paths; keep them off the public repo.
docs/

# Conformance screenshot artifacts — PNGs stay local / CI artifacts; the
# committed regression signal is baselines/<platform>.hashes.json (plan 12).
conformance/artifacts/
