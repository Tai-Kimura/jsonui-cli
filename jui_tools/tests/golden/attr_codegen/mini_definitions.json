{
  "_comment": "Golden-test fixture — exercises every classification shape found in the real attribute_definitions.json",
  "common": {
    "_comment": "Common attributes shared across all components",
    "id": {
      "type": "string",
      "description": "Unique identifier for the component"
    },
    "width": {
      "type": [
        "number",
        {
          "enum": [
            "matchParent",
            "wrapContent"
          ]
        },
        "binding"
      ],
      "required": true,
      "description": "Width (number, 'matchParent', 'wrapContent') - binding supported"
    },
    "visibility": {
      "type": [
        "string",
        "binding"
      ],
      "enum": [
        "visible",
        "invisible",
        "gone"
      ],
      "description": "View visibility state (can be data binding)"
    },
    "opacity": {
      "type": [
        "number",
        "binding"
      ],
      "aliases": [
        "alpha"
      ],
      "min": 0,
      "max": 1,
      "description": "Opacity/alpha value (0-1)"
    },
    "onClick": {
      "type": "binding",
      "description": "Click handler (camelCase) - binding only (@{functionName})"
    },
    "generatedBy": {
      "type": "string",
      "description": "AI generation command that created this component (metadata only, not rendered)"
    },
    "shadow": {
      "type": [
        "string",
        "object"
      ],
      "description": "Shadow configuration (string or object)"
    },
    "hidden": {
      "type": [
        "boolean",
        "binding"
      ],
      "description": "Hide view"
    }
  },
  "Label": {
    "text": {
      "type": [
        "string",
        "binding"
      ],
      "description": "Text content (supports data binding)"
    },
    "textTransform": {
      "type": "string",
      "enum": [
        "none",
        "wrap-reverse",
        "Flow",
        "flow"
      ],
      "default": "none",
      "description": "Text transformation (legacy spellings kept for compat)"
    },
    "edgeInset": {
      "type": "number",
      "deprecated": true,
      "deprecation_note": "Compose Text has no edgeInset; use padding* instead.",
      "description": "Label internal padding"
    },
    "onItemAppear": {
      "type": "callback",
      "description": "Called with the cell index when a cell appears"
    },
    "value": {
      "type": "any",
      "description": "Associated value"
    },
    "bind": {
      "type": "binding",
      "binding_direction": "two-way",
      "description": "Two-way binding @{variable}"
    },
    "partialAttributes": {
      "type": "array",
      "description": "Partial text styling"
    },
    "highlightColor": {
      "type": "string",
      "aliases": [
        "hilightColor"
      ],
      "description": "Highlight color - hex string or color name from colors.json"
    },
    "shadow": {
      "type": "object",
      "description": "Label-specific shadow override (object only)"
    }
  },
  "Text": {
    "_alias_of": "Label",
    "_comment": "Component alias fixture: emitted as a full clone of Label."
  }
}
