{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/forward.py"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/session_env.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/forward.py"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
