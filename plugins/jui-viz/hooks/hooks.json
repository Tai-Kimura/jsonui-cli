          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/scripts/forward.py",
              "--ask"
            ],
            "timeout": 86400
          }
        ]
      }
    ],
    "PostToolUse": [
