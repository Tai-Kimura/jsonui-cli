    "medium": {
      "swift": ".medium",
      "kotlin": "FontWeight.Medium",
      "css": "500"
    },
    "semibold": {
      "swift": ".semibold",
      "kotlin": "FontWeight.SemiBold",
      "css": "600"
    },
    "bold": {
      "swift": ".bold",
