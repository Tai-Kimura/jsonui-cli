    {
      "name": "flow: viewModels is the payload's screens as written, keyed by screen id",
      "test": {
        "type": "flow",
        "sources": [
          {
            "layout": "Layouts/login.json"
          },
          {
            "layout": "Layouts/home.json"
          }
        ],
        "metadata": {
          "name": "f"
        },
        "initialState": {
          "viewModels": {
            "login": {
              "email": "a"
            },
            "home": {
              "tab": 1
            }
          }
        },
        "steps": [
          {
            "screen": "login",
            "action": "tap",
            "id": "sign_in_button"
          }
        ]
      },
      "expect": {
        "launches": [
          {
            "before": "file",
            "screens": {
              "login": {
                "email": "a"
              },
              "home": {
                "tab": 1
              }
            }
          }
        ],
        "caseFailures": [],
        "warnings": [],
        "validateErrors": []
      }
    },
    {
      "name": "flow: a referenced file's / case's initialState is not applied inside the flow — warned, never delivered",
      "test": {
        "type": "flow",
        "sources": [
          {
            "layout": "Layouts/login.json"
          },
          {
            "layout": "Layouts/home.json"
          }
        ],
        "metadata": {
          "name": "f"
        },
        "steps": [
          {
            "file": "screens/login"
          },
          {
            "file": "screens/home",
            "case": "b"
          }
        ]
      },
      "files": {
        "screens/login": {
          "type": "screen",
          "source": {
            "layout": "Layouts/login.json"
          },
          "metadata": {
            "name": "t"
          },
          "initialState": {
            "viewModel": {
              "email": "a"
            }
          },
          "cases": [
            {
              "name": "a",
              "steps": [
                {
                  "assert": "visible",
                  "id": "title_label"
                }
              ]
            }
          ]
        },
        "screens/home": {
          "type": "screen",
          "source": {
            "layout": "Layouts/home.json"
          },
          "metadata": {
            "name": "t"
          },
          "cases": [
            {
              "name": "a",
              "steps": [
                {
                  "assert": "visible",
                  "id": "title_label"
                }
              ]
            },
            {
              "name": "b",
              "steps": [
                {
                  "assert": "visible",
                  "id": "title_label"
                }
              ],
              "initialState": {
                "viewModel": {
                  "tab": 2
                }
              }
            }
          ]
        }
      },
      "expect": {
        "launches": [],
        "caseFailures": [],
        "warnings": [
          {
            "code": "referenced-initial-state-ignored",
            "file": "screens/login"
          },
          {
            "code": "referenced-initial-state-ignored",
            "file": "screens/home",
            "case": "b"
          }
        ],
        "validateErrors": []
      }
    },
    {
      "name": "flow: initialState.screen is removed from the schema",
      "test": {
        "type": "flow",
