    {
      "name": "reopen: one launch per case, file merged with case, key by key",
      "test": {
        "type": "screen",
        "source": {
          "layout": "Layouts/login.json"
        },
        "metadata": {
          "name": "t"
        },
        "caseIsolation": "reopen",
        "initialState": {
          "viewModel": {
            "email": "a",
            "password": "p"
          }
        },
        "cases": [
          {
            "name": "a",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ]
          },
          {
            "name": "b",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ],
            "initialState": {
              "viewModel": {
                "email": "b"
              }
            }
          },
          {
            "name": "c",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ],
            "initialState": {
              "viewModel": {
                "remember": true
              }
            }
          }
        ]
      },
      "expect": {
        "launches": [
          {
            "before": "case:a",
            "screens": {
              "login": {
                "email": "a",
                "password": "p"
              }
            }
          },
          {
            "before": "case:b",
            "screens": {
              "login": {
                "email": "b",
                "password": "p"
              }
            }
          },
          {
            "before": "case:c",
            "screens": {
              "login": {
                "email": "a",
                "password": "p",
                "remember": true
              }
            }
          }
        ],
        "caseFailures": [],
        "warnings": [],
        "validateErrors": []
      }
    },
    {
      "name": "reopen: the merge is shallow — a case's object value replaces the file's whole, it is not merged into it",
      "test": {
        "type": "screen",
        "source": {
          "layout": "Layouts/login.json"
        },
        "metadata": {
          "name": "t"
        },
        "caseIsolation": "reopen",
        "initialState": {
          "viewModel": {
            "filters": {
              "a": 1,
              "b": 2
            }
          }
        },
        "cases": [
          {
            "name": "a",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ],
            "initialState": {
              "viewModel": {
                "filters": {
                  "a": 3
                }
              }
            }
          }
        ]
      },
      "expect": {
        "launches": [
          {
            "before": "case:a",
            "screens": {
              "login": {
                "filters": {
                  "a": 3
                }
              }
            }
          }
        ],
        "caseFailures": [],
        "warnings": [],
        "validateErrors": []
      }
    },
