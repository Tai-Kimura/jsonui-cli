    {
      "name": "shared, a case-level initialState fails that case (setup) and only that case; the file payload still goes",
      "test": {
        "type": "screen",
        "source": {
          "layout": "Layouts/login.json"
        },
        "metadata": {
          "name": "t"
        },
        "initialState": {
          "viewModel": {
            "email": "a"
          }
        },
        "cases": [
          {
            "name": "a",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ]
          },
          {
            "name": "b",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ],
            "initialState": {
              "viewModel": {
                "email": "b"
              }
            }
          },
          {
            "name": "c",
            "steps": [
              {
                "assert": "visible",
                "id": "title_label"
              }
            ]
          }
        ]
      },
      "expect": {
        "launches": [
          {
            "before": "file",
            "screens": {
              "login": {
                "email": "a"
              }
            }
          }
        ],
        "caseFailures": [
          {
            "case": "b",
            "failureReason": "setup",
            "code": "case-initial-state-needs-reopen"
          }
        ],
        "warnings": [],
        "validateErrors": [
          {
            "code": "case-initial-state-needs-reopen",
            "case": "b"
          }
        ]
      }
    },
