    {
      "id": "data_from_a_style",
      "why": "A style's data[] merged into a node with other keys: sjui / kjui read it; rjui does not (the node has keys besides data and type).",
      "files": {
        "layouts/screen.json": {
          "type": "View",
          "data": [
            {
              "name": "own",
              "class": "String"
            }
          ],
          "child": [
            {
              "type": "View",
              "style": "withdata"
            }
          ]
        },
        "styles/withdata.json": {
          "background": "#FFFFFF",
          "data": [
            {
              "name": "styled",
              "class": "String"
            }
          ]
        }
      },
      "screen": "screen",
      "expected": {
        "ios": [
          [
            "own",
            "String"
          ],
          [
            "styled",
            "String"
          ]
        ],
        "android": [
