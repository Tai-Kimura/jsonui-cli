            "pIosWeb",
            "String"
          ]
        ]
      }
    },
    {
      "id": "mode_filter",
      "why": "An item's mode keeps it to that mode: sjui is swiftui, kjui compose (its default); rjui does not read mode.",
      "files": {
        "layouts/screen.json": {
          "type": "View",
          "data": [
            {
              "name": "mAll",
              "class": "String"
            },
            {
              "name": "mSwiftui",
              "class": "String",
              "mode": "swiftui"
            },
            {
              "name": "mCompose",
              "class": "String",
              "mode": "compose"
            },
            {
              "name": "mUikit",
              "class": "String",
              "mode": "uikit"
            }
          ]
        }
      },
      "screen": "screen",
      "expected": {
        "ios": [
          [
            "mAll",
            "String"
          ],
          [
            "mSwiftui",
            "String"
          ]
        ],
        "android": [
          [
            "mAll",
            "String"
          ],
          [
            "mCompose",
            "String"
          ]
        ],
        "web": [
          [
            "mAll",
            "String"
          ],
          [
            "mSwiftui",
            "String"
          ],
          [
            "mCompose",
            "String"
          ],
          [
            "mUikit",
            "String"
          ]
        ]
      }
    },
    {
      "id": "include_with_id",
      "why": "An include's data (the partial's, then the include node's own) is the screen's, each name prefixed by the include id in camelCase.",
      "files": {
        "layouts/screen.json": {
          "type": "View",
          "data": [
            {
              "name": "own",
              "class": "String"
            }
          ],
          "child": [
            {
              "include": "part",
              "id": "header",
              "data": [
                {
                  "name": "extra",
                  "class": "Int"
                }
              ]
            }
          ]
        },
        "layouts/part.json": {
          "type": "View",
          "data": [
            {
              "name": "title_text",
              "class": "String"
            }
          ],
          "child": [
            {
              "type": "Label",
              "id": "t",
              "text": "@{title_text}"
            }
          ]
        }
      },
      "screen": "screen",
      "expected": {
        "ios": [
          [
            "own",
            "String"
          ],
          [
            "headerTitleText",
            "String"
          ],
          [
            "headerExtra",
            "Int"
          ]
        ],
        "android": [
          [
            "own",
            "String"
          ],
          [
            "headerTitleText",
            "String"
          ],
          [
            "headerExtra",
            "Int"
          ]
        ],
        "web": [
          [
            "own",
            "String"
          ],
          [
            "headerTitleText",
            "String"
          ],
          [
            "headerExtra",
            "Int"
          ]
        ]
      }
    },
