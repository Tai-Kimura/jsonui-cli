        "web": [
          [
            "own",
            "String"
          ]
        ]
      }
    },
    {
      "id": "object_form_data_is_not_declared",
      "why": "data as an object (the style shorthand) gives no declared field on any platform: sjui / kjui infer a property from it without declaring it, rjui does not read it.",
      "files": {
        "layouts/screen.json": {
          "type": "View",
          "data": {
            "k": 1
          },
          "child": []
        }
      },
      "screen": "screen",
      "expected": {
        "ios": [],
        "android": [],
        "web": []
      }
    },
    {
      "id": "generated_fields_are_not_declared",
      "why": "The fields a generator adds by itself — <id>IsFocused for a text field, the Radio group's selection — are not declared data.",
      "files": {
        "layouts/screen.json": {
          "type": "View",
          "data": [
            {
              "name": "own",
              "class": "String"
            }
          ],
          "child": [
            {
              "type": "TextField",
              "id": "email_field",
              "text": "@{own}"
            },
            {
              "type": "Radio",
              "id": "r1",
              "text": "one"
            }
          ]
        }
      },
      "screen": "screen",
      "expected": {
        "ios": [
          [
            "own",
            "String"
          ]
        ],
        "android": [
          [
            "own",
            "String"
          ]
        ],
        "web": [
          [
            "own",
            "String"
          ]
        ]
