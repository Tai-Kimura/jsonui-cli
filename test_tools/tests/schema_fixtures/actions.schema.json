{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jsonui.dev/schemas/actions.schema.json",
  "title": "JsonUI Test Actions and Assertions",
  "description": "Definitions for test actions and assertions used in JsonUI test cases",
  "definitions": {
    "elementId": {
      "type": "string",
      "description": "The id attribute of the target element in JsonUI layout",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "description": "Direction for scroll/swipe actions"
    },
    "label": {
      "type": "string",
      "description": "Human-readable step name used in logs and reports"
    },
    "optional": {
      "type": "boolean",
      "default": false,
      "description": "When true, a failure of this step is recorded as a warning and execution continues"
    },
    "responsive": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "compact",
            "medium",
            "regular",
            "landscape",
            "compact-landscape",
            "medium-landscape",
            "regular-landscape"
          ],
          "description": "Named size-class bucket from the render-side canonical vocabulary; each driver resolves it the way its platform's renderer does"
        },
        {
          "type": "object",
          "properties": {
            "minWidth": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum window width (inclusive). Units: dp (Android) / pt (iOS) / logical px (web)"
            },
            "maxWidth": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum window width (inclusive). Units: dp (Android) / pt (iOS) / logical px (web)"
            },
            "minHeight": {
              "type": "number",
              "minimum": 0,
              "description": "Minimum window height (inclusive). Units: dp (Android) / pt (iOS) / logical px (web)"
            },
            "maxHeight": {
              "type": "number",
              "minimum": 0,
              "description": "Maximum window height (inclusive). Units: dp (Android) / pt (iOS) / logical px (web)"
            },
            "orientation": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape"
              ],
              "description": "Current device/viewport orientation matches"
            }
          },
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Explicit size constraint; keys are ANDed. Uniform numeric evaluation on all platforms (does NOT track iOS size classes — use a named bucket for renderer-faithful gating there)"
        }
      ],
      "description": "Current size matches: a named size-class bucket or an explicit size constraint, resolved at run time on the device"
    },
    "condition": {
      "type": "object",
      "description": "Condition object for 'when' (step pre-condition) and 'repeat.while'. Multiple keys are ANDed.",
      "properties": {
        "visible": {
          "$ref": "#/definitions/elementId",
          "description": "Instant check: element is currently visible"
        },
        "notVisible": {
          "$ref": "#/definitions/elementId",
          "description": "Instant check: element is currently absent or invisible"
        },
        "platform": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ios",
                "android",
                "web",
                "all"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ios",
                  "android",
                  "web"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "Current platform matches"
        },
        "responsive": {
          "$ref": "#/definitions/responsive",
          "description": "Current size class / window size matches (resolved at runtime from the live device/viewport size)"
        },
        "state": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Dot-notation path to ViewModel property"
            },
            "equals": {
              "description": "Expected value (any type)"
            }
          },
          "required": [
            "path",
            "equals"
          ],
          "additionalProperties": false,
          "description": "ViewModel state matches (requires a state provider)"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "launch": {
      "type": "object",
      "description": "App launch configuration applied before the app under test starts",
      "properties": {
        "clearState": {
          "type": "boolean",
          "default": false,
          "description": "Clear app data before launch (iOS: JSONUI_TEST_CLEAR_STATE env contract; Android: pm clear; Web: cookies + storage)"
        },
        "permissions": {
          "type": "object",
          "description": "Permission grants applied before launch",
          "propertyNames": {
            "enum": [
              "camera",
              "microphone",
              "location",
              "notifications",
              "photos",
              "contacts",
              "calendar",
              "bluetooth"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "unset"
            ]
          }
        },
        "arguments": {
          "type": "object",
          "description": "Launch arguments passed to the app (iOS: launchEnvironment JSONUI_TEST_ARGS; Android: intent extras; Web: sessionStorage)",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/definitions/tapAction"
        },
        {
          "$ref": "#/definitions/doubleTapAction"
        },
        {
          "$ref": "#/definitions/longPressAction"
        },
        {
          "$ref": "#/definitions/inputAction"
        },
        {
          "$ref": "#/definitions/typeTextAction"
        },
        {
          "$ref": "#/definitions/clearAction"
        },
        {
          "$ref": "#/definitions/scrollAction"
        },
        {
          "$ref": "#/definitions/scrollUntilVisibleAction"
        },
        {
          "$ref": "#/definitions/swipeAction"
        },
        {
          "$ref": "#/definitions/waitForAction"
        },
        {
          "$ref": "#/definitions/waitForAnyAction"
        },
        {
          "$ref": "#/definitions/waitAction"
        },
        {
          "$ref": "#/definitions/backAction"
        },
        {
          "$ref": "#/definitions/hideKeyboardAction"
        },
        {
          "$ref": "#/definitions/screenshotAction"
        },
        {
          "$ref": "#/definitions/alertTapAction"
        },
        {
          "$ref": "#/definitions/selectOptionAction"
        },
        {
          "$ref": "#/definitions/tapItemAction"
        },
        {
          "$ref": "#/definitions/selectTabAction"
        },
        {
          "$ref": "#/definitions/readTextAction"
        },
        {
          "$ref": "#/definitions/repeatAction"
        },
        {
          "$ref": "#/definitions/retryAction"
        },
        {
          "$ref": "#/definitions/setLocationAction"
        },
        {
          "$ref": "#/definitions/addMediaAction"
        },
        {
          "$ref": "#/definitions/setMocksAction"
        },
        {
          "$ref": "#/definitions/setViewportAction"
        },
        {
          "$ref": "#/definitions/setOrientationAction"
        },
        {
          "$ref": "#/definitions/emitHookAction"
        }
      ]
    },
    "tapAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "tap"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "text": {
          "type": "string",
          "description": "Specific text portion to tap within the element (e.g., tap '利用規約' within '利用規約に同意する')"
        },
        "retryTapIfNoChange": {
          "type": "boolean",
          "default": false,
          "description": "Re-tap once when the UI did not change after the tap (ghost-tap mitigation; no-op on web)"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "doubleTapAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "doubleTap"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "longPressAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "longPress"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "duration": {
          "type": "integer",
          "minimum": 100,
          "default": 500,
          "description": "Duration in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "inputAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "input"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "value": {
          "type": "string",
          "description": "Text to input"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id",
        "value"
      ],
      "additionalProperties": false
    },
    "typeTextAction": {
      "type": "object",
      "description": "Type text into the currently-focused field via the keyboard, without targeting an element id. For fields that hold keyboard focus but are not directly targetable (e.g. an invisible code-entry TextField behind visible slots): focus is established app-side (auto-focus or a prior tap on a visible container), then typeText sends the characters.",
      "properties": {
        "action": {
          "const": "typeText"
        },
        "value": {
          "type": "string",
          "description": "Text to type into the focused field"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "value"
      ],
      "additionalProperties": false
    },
    "clearAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "clear"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "scrollAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "scroll"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "direction": {
          "$ref": "#/definitions/direction"
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "Scroll amount in pixels (optional)"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id",
        "direction"
      ],
      "additionalProperties": false
    },
    "scrollUntilVisibleAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "scrollUntilVisible"
        },
        "id": {
          "$ref": "#/definitions/elementId",
          "description": "Target element to bring into view"
        },
        "container": {
          "$ref": "#/definitions/elementId",
          "description": "Scrollable container to scroll (default: window / first scrollable view)"
        },
        "direction": {
          "$ref": "#/definitions/direction",
          "default": "down",
          "description": "Direction the content moves toward (down reveals content below)"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 20000,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "swipeAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "swipe"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "direction": {
          "$ref": "#/definitions/direction"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id",
        "direction"
      ],
      "additionalProperties": false
    },
    "waitForAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "waitFor"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "waitForAnyAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "waitForAny"
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/elementId"
          },
          "minItems": 1,
          "description": "Element ids; the step succeeds when any of them appears"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "ids"
      ],
      "additionalProperties": false
    },
    "waitAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "wait"
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Wait duration in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "ms"
      ],
      "additionalProperties": false
    },
    "backAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "back"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "hideKeyboardAction": {
      "type": "object",
      "description": "Dismiss the soft keyboard if one is visible (no-op when none). Needed when the keyboard covers the tap target and the field type has no return key (e.g. number-pad).",
      "properties": {
        "action": {
          "const": "hideKeyboard"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "screenshotAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "screenshot"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Screenshot file name (without extension)"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "name"
      ],
      "additionalProperties": false
    },
    "alertTapAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "alertTap"
        },
        "button": {
          "type": "string",
          "minLength": 1,
          "description": "Button text to tap in the alert dialog (e.g., 'OK', 'Cancel', 'Delete')"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds to wait for alert to appear"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "button"
      ],
      "additionalProperties": false
    },
    "selectOptionAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "selectOption"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "value": {
          "type": "string",
          "description": "Option value to select"
        },
        "label": {
          "type": "string",
          "description": "Option label (visible text) to select. NOTE: for selectOption, 'label' keeps its original meaning (option text), NOT the universal step-name attribute"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Option index to select (0-based)"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id"
      ],
      "additionalProperties": false
    },
    "tapItemAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "tapItem"
        },
        "id": {
          "$ref": "#/definitions/elementId",
          "description": "Collection element id; item is resolved as {id}_item_{index}"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Item index to tap (0-based)"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id",
        "index"
      ],
      "additionalProperties": false
    },
    "selectTabAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "selectTab"
        },
        "id": {
          "$ref": "#/definitions/elementId",
          "description": "Tab view element id; tab is resolved as {id}_tab_{index}"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Tab index to select (0-based)"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id",
        "index"
      ],
      "additionalProperties": false
    },
    "readTextAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "readText"
        },
        "id": {
          "$ref": "#/definitions/elementId"
        },
        "variable": {
          "type": "string",
          "minLength": 1,
          "description": "Runtime variable name; later steps reference it as @{name}"
        },
        "timeout": {
          "type": "integer",
          "minimum": 0,
          "default": 5000,
          "description": "Timeout in milliseconds"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "id",
        "variable"
      ],
      "additionalProperties": false
    },
    "repeatAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "repeat"
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "description": "Iteration count (with 'while': acts as the cap)"
        },
        "while": {
          "$ref": "#/definitions/condition",
          "description": "Loop while this condition holds (checked before each iteration; safety cap 100 when used alone)"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          },
          "minItems": 1
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "steps"
      ],
      "anyOf": [
        {
          "required": [
            "times"
          ]
        },
        {
          "required": [
            "while"
          ]
        }
      ],
      "additionalProperties": false
    },
    "retryAction": {
      "type": "object",
      "properties": {
        "action": {
          "const": "retry"
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 1,
          "description": "Number of retries after the first attempt (capped at 3 by design)"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          },
          "minItems": 1
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "optional": {
          "$ref": "#/definitions/optional"
        },
        "when": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "action",
        "steps"
      ],
