{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jsonui.dev/schemas/results.schema.json",
  "title": "JsonUI Test Results",
  "description": "Standardized test-run results emitted by all platform drivers; consumed by `jsonui-test report`",
  "type": "object",

  "properties": {
    "format": { "const": "jsonui-test-results" },
    "version": { "const": 1 },
    "platform": {
      "type": "string",
      "enum": ["ios", "android", "web"]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suiteName": { "type": "string" },
          "totalDurationMs": { "type": "number", "minimum": 0 },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "testName": { "type": "string" },
                "caseName": { "type": "string" },
                "status": {
                  "type": "string",
                  "enum": ["passed", "failed", "skipped"]
                },
                "error": { "type": "string" },
                "skipReason": {
                  "type": "string",
                  "enum": ["platform", "responsive"],
                  "description": "Why a skipped result was skipped (platform gate vs responsive gate); only meaningful when status is 'skipped'"
                },
                "warnings": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "durationMs": { "type": "number", "minimum": 0 },
                "attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "How many times the case ran in total, retries included (1 = settled on the first run). Absent when the driver does not track attempts. Without this, a pass on the second attempt is byte-identical to a first-run pass and flake rates cannot be computed."
                },
                "flaky": {
                  "type": "boolean",
                  "description": "True when the case ultimately passed but needed more than one attempt. Absent when the driver does not track attempts; only meaningful when status is 'passed'"
                }
              },
              "required": ["testName", "caseName", "status", "durationMs"],
              "additionalProperties": false
            }
          }
        },
        "required": ["suiteName", "results"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "platform", "suites"],
  "additionalProperties": false
}
